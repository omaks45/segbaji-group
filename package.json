    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
