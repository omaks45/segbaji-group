generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// Declared now per request, ahead of the Project model itself — not
// attached to anything yet since Project doesn't exist. Wire this to
// Project.status once that model lands in its own phase.
enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

  enum QuoteRequestStatus {
  NEW
  CONTACTED
  WON
  LOST
}

enum ContactMessageStatus {
  UNREAD
  READ
  RESPONDED
}

enum ClientSource {
  QUOTE_REQUEST
  CONTACT_MESSAGE
  MANUAL
}

model User {
  id                String     @id @default(cuid())
  fullName          String?    // unknown until the invitee completes registration
  email             String     @unique
  passwordHash      String?    // unset until registration is completed
  phone             String?
  bio               String?
  profilePictureUrl String?
  profilePicturePublicId String?
  status            UserStatus @default(PENDING)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id])

  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inviteToken         InviteToken?
  passwordResetTokens PasswordResetToken[]

  @@index([departmentId])
  @@index([roleId])
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id                String           @id @default(cuid())
  slug              String?          @unique
  name              String           @unique
  summary           String?
  heroImageUrl      String?
  heroImagePublicId String?
  isActive          Boolean          @default(true)
  order             Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  features          ServiceFeature[]
  quoteRequests     QuoteRequest[]

  @@index([isActive])
}

model ServiceFeature {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
}

model InviteToken {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}


model QuoteRequest {
  id               String             @id @default(cuid())
  serviceId        String
  service          Service            @relation(fields: [serviceId], references: [id])
  fullName         String
  email            String
  phone            String
  projectLocation  String
  budgetRange      String             // free text, per your call
  desiredStartDate DateTime
  description      String
  status           QuoteRequestStatus @default(NEW)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  convertedToClientId String?
  convertedToClient   Client? @relation(fields: [convertedToClientId], references: [id])
  @@index([convertedToClientId])

  @@index([status])
  @@index([serviceId])
}

model ContactMessage {

  id        String                @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactMessageStatus  @default(UNREAD)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

    convertedToClientId String?
  convertedToClient   Client? @relation(fields: [convertedToClientId], references: [id])

  @@index([status])
  @@index([convertedToClientId])
}

model Client {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  phone        String?
  organization String?
  source       ClientSource
  notes        String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quoteRequests   QuoteRequest[]
  contactMessages ContactMessage[]

  @@index([isActive])
}