generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// Declared now per request, ahead of the Project model itself — not
// attached to anything yet since Project doesn't exist. Wire this to
// Project.status once that model lands in its own phase.
enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

  enum QuoteRequestStatus {
  NEW
  CONTACTED
  WON
  LOST
}

enum ContactMessageStatus {
  UNREAD
  READ
  RESPONDED
}

enum ClientSource {
  QUOTE_REQUEST
  CONTACT_MESSAGE
  MANUAL
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRASTRUCTURE
  INSTITUTIONAL
}

enum PropertyType {
  RESIDENTIAL_PLOT
  COMMERCIAL_LAND
  INDUSTRIAL_LAND
  ESTATE_PLOT
  OTHER
}

enum LandSizeUnit {
  ACRES
  HECTARES
  PLOTS
}

enum LandCondition {
  DRY
  WET
  FENCED
  GATED_ESTATE
}

enum TitleType {
  C_OF_O
  GOVERNORS_CONSENT
  EXCISION
  GOVERNMENT_ALLOCATION
  DEED_OF_ASSIGNMENT
  OTHER
}

enum PropertyAvailabilityStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  DRAFT
}

enum PriceType {
  TOTAL
  PER_ACRE
  PER_HECTARE
  PER_PLOT
}

enum NearbyPlaceType {
  SCHOOL
  HOSPITAL
  COMPANY_OFFICE
  BRIDGE
  FUEL_STATION
  HIGHWAY
}



enum DateRangePreset {
  TODAY
  THIS_WEEK
  THIS_MONTH
  THIS_QUARTER
  THIS_YEAR
  CUSTOM
}

enum ReportFormat {
  CSV
  XLSX
}

enum ReportGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TaskStatus {
  PENDING      // assigned to a department as a whole, no individual owner yet
  ASSIGNED     // has an assignee, not yet started
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  QUOTE_REQUEST
  CONTACT_MESSAGE
  NEW_MESSAGE
  TASK_ASSIGNED
  TASK_REASSIGNED
}

model User {
  id                String     @id @default(cuid())
  fullName          String?
  email             String     @unique
  passwordHash      String?
  phone             String?    @unique
  bio               String?
  profilePictureUrl String?
  profilePicturePublicId String?
  status            UserStatus @default(PENDING)

  isPubliclyListed   Boolean @default(false)
  publicDisplayTitle String?
  publicDisplayOrder Int     @default(0)

  isTeamLead Boolean @default(false)   // new — leadership over their department, independent of professional role

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id])

  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inviteToken         InviteToken?
  passwordResetTokens PasswordResetToken[]

  @@index([departmentId])
  @@index([roleId])
  generatedReports GeneratedReport[]
  loginActivities LoginActivity[]
  sessions Session[]
  conversations Conversation[] @relation("ConversationsCreated")
  conversationParticipants ConversationParticipant[]
  messages Message[]
  messageAttachments MessageAttachment[]
  tasksAssigned Task[] @relation("TasksAssigned")
  tasksCreated Task[] @relation("TasksCreated")
  notifications Notification[]
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks         Task[]
  services      Service[]        // new
  quoteRequests QuoteRequest[]   // new
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String           @unique
  summary           String?
  description       String?          // new
  category          String?          // new — free text, same call as budgetRange
  heroImageUrl      String?
  heroImagePublicId String?
  isActive          Boolean          @default(true)
  order             Int              @default(0)
  departmentId      String?          // new
  department        Department?      @relation(fields: [departmentId], references: [id])  // new
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  features          ServiceFeature[]
  quoteRequests     QuoteRequest[]

  @@index([isActive])
  @@index([departmentId])   // new
}

model ServiceFeature {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
}

model InviteToken {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}


model QuoteRequest {
  id               String             @id @default(cuid())
  serviceId        String
  service          Service            @relation(fields: [serviceId], references: [id])
  departmentId     String?            // new — copied from service.departmentId at create time
  department       Department?        @relation(fields: [departmentId], references: [id])  // new
  fullName         String
  email            String
  phone            String
  projectLocation  String
  budgetRange      String
  desiredStartDate DateTime
  description      String
  status           QuoteRequestStatus @default(NEW)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  convertedToClientId String?
  convertedToClient   Client? @relation(fields: [convertedToClientId], references: [id])

  @@index([convertedToClientId])
  @@index([status])
  @@index([serviceId])
  @@index([departmentId])   // new
}

model ContactMessage {

  id        String                @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactMessageStatus  @default(UNREAD)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

    convertedToClientId String?
  convertedToClient   Client? @relation(fields: [convertedToClientId], references: [id])

  @@index([status])
  @@index([convertedToClientId])
}

model Client {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  phone        String?
  organization String?
  source       ClientSource
  notes        String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quoteRequests   QuoteRequest[]
  contactMessages ContactMessage[]

  @@index([isActive])
  conversations Conversation[]
}

model SiteStat {
  id                         String   @id
  yearsOfExperience          Float    @default(0)
  yearsOfExperienceSuffix    String   @default("+")
  projectsCompleted          Float    @default(0)
  projectsCompletedSuffix    String   @default("+")
  clientSatisfactionRating   Float    @default(0)
  clientSatisfactionSuffix   String   @default("/5")
  skilledProfessionals       Float    @default(0)
  skilledProfessionalsSuffix String   @default("+")
  updatedAt                  DateTime @updatedAt
}

model SiteSettings {
  id               String   @id
  officeAddress    String?
  phonePrimary     String?
  phoneSecondary   String?
  email            String?
  officeHours      String?
  facebookUrl      String?
  instagramUrl     String?
  twitterUrl       String?
  linkedinUrl      String?
  whatsappNumber   String?
  missionStatement String?
  officeLatitude  Float?
  officeLongitude Float?
  visionStatement  String?
  companyStory     String?
  updatedAt        DateTime @updatedAt
}

model CoreValue {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PageKey {
  HOME
  ABOUT
  SERVICES
  PROPERTIES
  PROJECTS
  CONTACT
  QUOTE
}

model SeoMeta {
  id          String   @id @default(cuid())
  pageKey     PageKey  @unique
  title       String
  description String
  updatedAt   DateTime @updatedAt
}



model Project {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String?
  category      ProjectCategory?
  contractValue Decimal?  @db.Decimal(14, 2)
  isPublished   Boolean   @default(true)
  order         Int       @default(0)
  images        ProjectImage[]
  videos        ProjectVideo[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations Conversation[]

  tasks Task[]
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectVideo {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  videoUrl     String
  publicId     String
  thumbnailUrl String?
  duration     Float?
  caption      String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([projectId])
}


model Property {
  id                 String                     @id @default(cuid())
  slug               String                     @unique
  title              String
  description        String?
  propertyType       PropertyType
  landSizeValue      Float
  landSizeUnit       LandSizeUnit
  price              Float
  priceType          PriceType                  @default(TOTAL)
  isPriceNegotiable  Boolean                    @default(false)
  location           String
  state              String
  landCondition      LandCondition
  titleType          TitleType
  availabilityStatus PropertyAvailabilityStatus @default(DRAFT)
  latitude           Float?
  longitude          Float?
  coverImageUrl      String?
  coverImagePublicId String?
  isFeatured         Boolean                    @default(false)
  order              Int                        @default(0)

  // Fixed 8-boolean features checklist — matches your call to keep this
  // as flat columns rather than a flexible child table.
  hasVerifiedTitle     Boolean @default(false)
  hasDryLand           Boolean @default(false)
  hasGoodRoadNetwork   Boolean @default(false)
  hasSecureEnvironment Boolean @default(false)
  hasElectricityNearby Boolean @default(false)
  hasDrainageSystem    Boolean @default(false)
  hasSurveyPlan        Boolean @default(false)
  isGovernmentApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       PropertyImage[]
  nearbyPlaces PropertyNearbyPlace[]
  tasks Task[]

  @@index([propertyType])
  @@index([state])
  @@index([availabilityStatus])
  @@index([price])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  imageUrl   String
  publicId   String
  caption    String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyNearbyPlace {
  id             String          @id @default(cuid())
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type           NearbyPlaceType
  label          String?
  distanceOrTime String

  @@unique([propertyId, type])
  @@index([propertyId])
}


model GeneratedReport {
  id          String                 @id @default(cuid())
  name        String
  description String?
  format      ReportFormat
  preset      String // stores the DateRangePreset used, so the record shows what it actually covers
  rangeFrom   DateTime
  rangeTo     DateTime
  status      ReportGenerationStatus @default(PENDING)
  fileUrl     String?
  filePublicId String?
  errorMessage String?

  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id])

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([generatedById])
}

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  name        String?          // only meaningful for GROUP
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])
  createdById String
  createdBy   User             @relation("ConversationsCreated", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([clientId])
  @@index([projectId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String?
  createdAt      DateTime     @default(now())
  
  editedAt  DateTime?
  deletedAt DateTime?

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  filename  String
  mimeType  String?
  sizeBytes Int?
  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id])
  createdAt DateTime @default(now())

  @@index([messageId])
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?

  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])

  assigneeId   String?
  assignee     User?        @relation("TasksAssigned", fields: [assigneeId], references: [id])

  assignedById String
  assignedBy   User         @relation("TasksCreated", fields: [assignedById], references: [id])

  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id])
  propertyId   String?
  property     Property?    @relation(fields: [propertyId], references: [id])

  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([departmentId])
  @@index([assigneeId])
  @@index([status])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  link        String?          // frontend route to deep-link into, e.g. "/quote-requests/abc123"
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
}
